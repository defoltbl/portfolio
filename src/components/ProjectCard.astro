---
// One project on the home page. With a case study, the name and a "Case study" link open its page.
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const p = project.data;
const page = p.caseStudy ? `/projects/${project.id}/` : undefined;
---

<article class="card reveal" data-categories={p.categories.join(",")}>
  <div class="card-head">
    <h3 transition:name={page ? `project-${project.id}` : undefined}>{page ? <a href={page}>{p.name}</a> : p.name}</h3>
    {p.live && <span class="status"><span class="dot"></span>{p.liveLabel ?? "Live"}</span>}
  </div>
  <p class="card-tag">{p.tag}</p>
  <p class="card-body">{p.summary}</p>
  <ul class="stack">
    {p.stack.map((s) => <li>{s}</li>)}
  </ul>
  <div class="card-links">
    {page && <a href={page}>Case study →</a>}
    {p.live && <a href={p.live} target="_blank" rel="noopener">{p.liveLink} ↗</a>}
    <a href={p.source} target="_blank" rel="noopener">Source ↗</a>
  </div>
</article>
