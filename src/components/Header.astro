---
// The top bar: monogram, section links, theme switch. On other pages the links lead back to the home page.
import { sections } from "../data/profile";

interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
const base = home ? "" : "/";
---

<header class="topbar">
  <a class="brand" href={home ? "#top" : "/"}>AM</a>
  <div class="nav-right">
    <nav aria-label="Primary">
      {sections.map(([id, label]) => <a href={`${base}#${id}`}>{label}</a>)}
    </nav>
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
      <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
      <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4.2"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
    </button>
  </div>
</header>
