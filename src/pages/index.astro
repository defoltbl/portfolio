---
// Home page: hero, about, projects, skills, experience, education, publications, contact.
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import SectionHead from "../components/SectionHead.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Timeline from "../components/Timeline.astro";
import { CATEGORIES } from "../content.config";
import { education, experience, mailto, person, profiles, publications, skills } from "../data/profile";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const used = new Set(projects.flatMap((p) => p.data.categories));
const filters = ["All", ...CATEGORIES.filter((c) => used.has(c))];

const description =
  "Junior Software Developer in backend, cloud and AI/ML. Deployed a Kotlin/Ktor REST API on Azure and published reinforcement-learning research at two international conferences.";
---

<Base title={`${person.name} – ${person.role} (Backend, Cloud & AI/ML)`} description={description} home>
  <section class="hero" id="top">
    <h1>{person.headline}</h1>
    <p class="lede">{person.lede}</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="#projects">View projects</a>
      <a class="btn" href={person.cv} target="_blank" rel="noopener">Download CV</a>
      {profiles.map((l) => <a class="btn" href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
    </div>
  </section>

  <section id="about" class="section">
    <SectionHead label="about" />
    <div class="prose">
      <p>
        I'm a Junior Software Developer with an MSc in Computer Science (with Honours) from
        Odesa Polytechnic National University, based in the Czech Republic. My MSc is recognized
        as equivalent to a Czech Master's degree in Informatika, and my BSc as equivalent to a
        Czech Bachelor's degree in Informatika (ČVUT Prague, 2026).
      </p>
      <p>
        I work with Python, Kotlin and SQL, and I like to build things end to end. I have taken
        projects from the first idea all the way to a deployed product, including an API running
        in the cloud and a document assistant powered by a local AI model, so I'm comfortable
        working on my own and finishing what I start.
      </p>
      <p>
        During my studies I spent three internships on research and software work, and presented
        my Master's research at two international conferences, which taught me to pick up new
        tools quickly and to explain technical ideas clearly. Native Ukrainian and Russian
        speaker, B2 English, looking for a Junior Software Developer role in Prague.
      </p>
    </div>
  </section>

  <section id="projects" class="section">
    <SectionHead label="projects" />
    <div class="filters" role="group" aria-label="Filter projects by category">
      {filters.map((f, i) => (
        <button class="filter-btn" type="button" data-filter={f} aria-pressed={i === 0 ? "true" : "false"}>{f}</button>
      ))}
    </div>
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section id="skills" class="section">
    <SectionHead label="skills" />
    <div class="skills">
      {skills.map((s) => (
        <div class="skill-group">
          <h4>{s.group}</h4>
          <ul>{s.items.map((i) => <li>{i}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section id="experience" class="section">
    <SectionHead label="experience" />
    <Timeline entries={experience} orgInline />
  </section>

  <section id="education" class="section">
    <SectionHead label="education" />
    <Timeline entries={education} />
  </section>

  <section id="publications" class="section">
    <SectionHead label="publications" />
    <Timeline entries={publications} />
  </section>

  <section id="contact" class="section contact">
    <SectionHead label="contact" />
    <h2>Open to junior software roles – on-site or hybrid in Prague, or remote.</h2>
    <p class="lede">The fastest way to reach me is by email.</p>
    <div class="cta-row">
      <a class="btn btn-primary" href={mailto}>Contact me</a>
      {profiles.slice().reverse().map((l) => <a class="btn" href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
    </div>
    <p class="loc">{person.location}</p>
  </section>
</Base>
